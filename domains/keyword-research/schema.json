{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KeywordResearchDomainContract",
  "description": "Data contract for keyword research, intent mapping, and competitor teardowns.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "required": ["client_slug", "services_or_cities", "request_type"],
      "properties": {
        "client_slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "services_or_cities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "request_type": {
          "type": "string",
          "enum": ["site_plan", "onboard", "realign", "gbp_optimize", "ad_hoc", "blog_preflight"]
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["keyword_map"],
      "properties": {
        "keyword_map": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["primary_keyword", "secondary_keywords", "volume", "difficulty", "intent", "source"],
            "properties": {
              "primary_keyword": { "type": "string" },
              "secondary_keywords": {
                "type": "array",
                "items": { "type": "string" }
              },
              "volume": {
                "oneOf": [
                  { "type": "integer", "minimum": 0 },
                  { "type": "string", "enum": ["estimated"] }
                ]
              },
              "difficulty": {
                "oneOf": [
                  { "type": "number", "minimum": 0, "maximum": 100 },
                  { "type": "string", "enum": ["estimated"] }
                ]
              },
              "intent": {
                "type": "string",
                "enum": ["informational", "navigational", "commercial", "transactional"]
              },
              "source": {
                "type": "string",
                "enum": ["semrush", "estimate"]
              }
            },
            "additionalProperties": false
          }
        },
        "competitor_teardown": {
          "type": "object",
          "required": ["top3_competitors", "client_position", "fastest_wins", "gaps_per_target_page"],
          "properties": {
            "top3_competitors": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": ["domain", "authority_score", "referring_domains", "organic_keywords", "traffic", "gbp_reviews"],
                "properties": {
                  "domain": { "type": "string" },
                  "authority_score": { "type": "integer" },
                  "referring_domains": { "type": "integer" },
                  "organic_keywords": { "type": "integer" },
                  "traffic": { "type": "number" },
                  "gbp_reviews": { "type": "integer" }
                },
                "additionalProperties": false
              }
            },
            "client_position": { "type": "string" },
            "fastest_wins": {
              "type": "array",
              "items": { "type": "string" }
            },
            "gaps_per_target_page": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
