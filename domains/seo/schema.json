{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SeoDomainContract",
  "description": "Data contract for Local SEO, GBP posts, GSC triage, and GEO reporting.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "required": ["client_slug", "skill"],
      "properties": {
        "client_slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "mcp_servers": {
          "type": "object",
          "properties": {
            "novamira": { "type": "string" },
            "ai_engine": { "type": "string" },
            "ghl": { "type": "string" }
          }
        },
        "skill": {
          "type": "string",
          "enum": [
            "/jnm-gsc-triage",
            "/jnm-geo",
            "/jnm-realign",
            "/jnm-gbp-optimize",
            "/jnm-gbp",
            "/jnm-report"
          ]
        },
        "keyword_refresh": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "gbp_output": {
      "type": "object",
      "required": ["posts"],
      "properties": {
        "posts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["type", "scheduled_date", "body_text_clean", "cta_type", "cta_url"],
            "properties": {
              "type": { "type": "string" },
              "scheduled_date": { "type": "string", "format": "date-time" },
              "body_text_clean": {
                "type": "string",
                "description": "Post body text without raw phone numbers or URLs."
              },
              "cta_type": {
                "type": "string",
                "enum": ["BOOK", "CALL", "LEARN_MORE", "OFFER"]
              },
              "cta_url": { "type": "string", "format": "uri" },
              "ghl_post_id": { "type": ["string", "null"] },
              "status": {
                "type": "string",
                "enum": ["published", "scheduled", "skipped-duplicate", "failed"]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "gsc_triage_output": {
      "type": "object",
      "required": ["buckets"],
      "properties": {
        "buckets": {
          "type": "object",
          "required": ["fix_now", "improve", "rebuild", "monitor"],
          "properties": {
            "fix_now": { "type": "array", "items": { "type": "string" } },
            "improve": { "type": "array", "items": { "type": "string" } },
            "rebuild": { "type": "array", "items": { "type": "string" } },
            "monitor": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
